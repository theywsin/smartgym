// SmartGym 2.0 — database schema (Phase 1: identity, tenancy, RBAC, SaaS plans, audit; Phase 2: members, memberships, attendance)
// Conventions: docs/DATABASE_DESIGN.md. Row-level security policies live in the SQL migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity ─────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  phone           String     @unique // E.164, e.g. +989121234567
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  passwordHash    String?    @map("password_hash")
  status          UserStatus @default(ACTIVE)
  isSuperAdmin    Boolean    @default(false) @map("is_super_admin")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile     UserProfile?
  sessions    Session[]
  memberships GymMembership[]
  ownedGyms   Gym[]           @relation("GymOwner")

  @@map("user")
}

model UserProfile {
  userId      String    @id @map("user_id") @db.Uuid
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  birthDate   DateTime? @map("birth_date") @db.Date
  gender      String?
  avatarFileId String?  @map("avatar_file_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

enum SessionKind {
  WEB
  MOBILE
}

/// Web sessions and mobile refresh tokens. Only SHA-256 hashes of tokens are stored.
model Session {
  id            String      @id @default(uuid(7)) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  kind          SessionKind
  tokenHash     String      @unique @map("token_hash")
  familyId      String      @map("family_id") @db.Uuid
  activeGymId   String?     @map("active_gym_id") @db.Uuid
  deviceName    String?     @map("device_name")
  ip            String?
  userAgent     String?     @map("user_agent")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt    DateTime    @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(3)
  replacedById  String?     @map("replaced_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("session")
}

enum OtpPurpose {
  LOGIN
  RESET_PASSWORD
  VERIFY_PHONE
}

model OtpChallenge {
  id         String     @id @default(uuid(7)) @db.Uuid
  phone      String
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  ip         String?
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@map("otp_challenge")
}

// ───────────────────────────── RBAC ─────────────────────────────

model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String // GYM_OWNER, COACH, … (custom roles later)
  gymId     String?  @map("gym_id") @db.Uuid // null = system role
  nameFa    String   @map("name_fa")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  gym         Gym?             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships GymMembership[]
  branchStaff BranchStaff[]

  @@unique([gymId, key])
  @@map("role")
}

model Permission {
  id    String           @id @default(uuid(7)) @db.Uuid
  key   String           @unique
  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

// ───────────────────────────── Tenancy ─────────────────────────────

enum GymStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

model Gym {
  id           String    @id @default(uuid(7)) @db.Uuid
  name         String
  slug         String    @unique
  status       GymStatus @default(TRIAL)
  ownerUserId  String    @map("owner_user_id") @db.Uuid
  logoFileId   String?   @map("logo_file_id") @db.Uuid
  primaryColor String?   @map("primary_color")
  timezone     String    @default("Asia/Tehran")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  owner         User              @relation("GymOwner", fields: [ownerUserId], references: [id])
  memberships   GymMembership[]
  branches      Branch[]
  branchStaff   BranchStaff[]
  settings      GymSetting[]
  subscriptions GymSubscription[]
  roles         Role[]
  auditLogs     AuditLog[]
  files         FileAsset[]
  members       Member[]
  plans         MembershipPlan[]
  memberSubs    MemberSubscription[]
  attendance    Attendance[]
  memberNotes   MemberNote[]
  coachProfiles CoachProfile[]
  coachAthletes CoachAthlete[]
  payments      Payment[]
  onlinePaymentRequests OnlinePaymentRequest[]
  expenseCategories ExpenseCategory[]
  expenses      Expense[]
  coachPayouts  CoachPayout[]
  products      Product[]
  notifications NotificationLog[]
  workoutPrograms WorkoutProgram[]
  sales         Sale[]
  ledger        LedgerEntry[]

  @@map("gym")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// A user's role in a gym (a user can belong to several gyms).
model GymMembership {
  id        String           @id @default(uuid(7)) @db.Uuid
  gymId     String           @map("gym_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  invitedBy String?          @map("invited_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([gymId, userId, roleId])
  @@index([userId])
  @@index([gymId, status])
  @@map("gym_membership")
}

model Branch {
  id            String    @id @default(uuid(7)) @db.Uuid
  gymId         String    @map("gym_id") @db.Uuid
  name          String
  address       String?
  phone         String?
  managerUserId String?   @map("manager_user_id") @db.Uuid
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  gym         Gym                  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  staff       BranchStaff[]
  homeMembers Member[]
  memberSubs  MemberSubscription[]
  attendance  Attendance[]

  @@index([gymId])
  @@map("branch")
}

/// Limits branch-scoped roles (branch manager, receptionist, store manager) to specific branches.
model BranchStaff {
  gymId    String @map("gym_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([branchId, userId, roleId])
  @@index([gymId, userId])
  @@map("branch_staff")
}

model GymSetting {
  gymId     String   @map("gym_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@id([gymId, key])
  @@map("gym_setting")
}

// ───────────────────────────── SaaS plans ─────────────────────────────

model Module {
  id     String                 @id @default(uuid(7)) @db.Uuid
  key    String                 @unique
  nameFa String                 @map("name_fa")
  plans  SubscriptionPlanModule[]

  @@map("module")
}

model SubscriptionPlan {
  id                String   @id @default(uuid(7)) @db.Uuid
  key               String   @unique
  nameFa            String   @map("name_fa")
  monthlyAmountRial BigInt   @map("monthly_amount_rial")
  annualAmountRial  BigInt   @map("annual_amount_rial")
  trialDays         Int      @default(0) @map("trial_days")
  limits            Json     @default("{}") // { members, branches, aiTokensPerMonth }
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  modules       SubscriptionPlanModule[]
  subscriptions GymSubscription[]

  @@map("subscription_plan")
}

model SubscriptionPlanModule {
  planId   String @map("plan_id") @db.Uuid
  moduleId String @map("module_id") @db.Uuid

  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  module Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([planId, moduleId])
  @@map("subscription_plan_module")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

model GymSubscription {
  id          String             @id @default(uuid(7)) @db.Uuid
  gymId       String             @map("gym_id") @db.Uuid
  planId      String             @map("plan_id") @db.Uuid
  status      SubscriptionStatus
  period      BillingPeriod      @default(MONTHLY)
  startsAt    DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime           @map("ends_at") @db.Timestamptz(3)
  trialEndsAt DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  cancelAt    DateTime?          @map("cancel_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym  Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([gymId, status])
  @@index([endsAt])
  @@map("gym_subscription")
}

// ───────────────────────────── Audit & files ─────────────────────────────

/// Append-only. The runtime DB role has no UPDATE/DELETE grant on this table.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  gymId       String?  @map("gym_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String?  @map("actor_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  gym Gym? @relation(fields: [gymId], references: [id])

  @@index([gymId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

enum FileVisibility {
  PRIVATE
  PUBLIC
}

model FileAsset {
  id          String         @id @default(uuid(7)) @db.Uuid
  gymId       String         @map("gym_id") @db.Uuid
  ownerUserId String?        @map("owner_user_id") @db.Uuid
  bucket      String
  key         String
  mimeType    String         @map("mime_type")
  sizeBytes   Int            @map("size_bytes")
  sha256      String
  visibility  FileVisibility @default(PRIVATE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([bucket, key])
  @@index([gymId])
  @@map("file_asset")
}

// ───────────────────────────── Members (Phase 2) ─────────────────────────────

enum MemberStatus {
  ACTIVE
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
}

/// A person registered at a gym. Whether they may enter is derived from their subscriptions,
/// not stored here. user_id links the athlete app account once they sign in with the same phone.
model Member {
  id               String       @id @default(uuid(7)) @db.Uuid
  gymId            String       @map("gym_id") @db.Uuid
  userId           String?      @map("user_id") @db.Uuid
  homeBranchId     String?      @map("home_branch_id") @db.Uuid
  code             Int // per-gym member number shown on cards and receipts
  firstName        String       @map("first_name")
  lastName         String       @map("last_name")
  phone            String? // E.164
  gender           Gender?
  birthDate        DateTime?    @map("birth_date") @db.Date
  nationalCode     String?      @map("national_code")
  emergencyContact Json?        @map("emergency_contact")
  notes            String?
  status           MemberStatus @default(ACTIVE)
  createdByUserId  String?      @map("created_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt       DateTime?    @map("archived_at") @db.Timestamptz(3)

  gym           Gym                  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  homeBranch    Branch?              @relation(fields: [homeBranchId], references: [id])
  subscriptions MemberSubscription[]
  attendance    Attendance[]
  notesLog      MemberNote[]
  coaches       CoachAthlete[]

  @@unique([gymId, code])
  @@index([gymId, status])
  @@index([gymId, phone])
  @@map("member")
}

model MembershipPlan {
  id               String    @id @default(uuid(7)) @db.Uuid
  gymId            String    @map("gym_id") @db.Uuid
  name             String
  description      String?
  durationDays     Int       @map("duration_days")
  priceAmountRial  BigInt    @map("price_amount_rial")
  entryLimit       Int?      @map("entry_limit") // null = unlimited entries during the period
  allowedBranchIds String[]  @default([]) @map("allowed_branch_ids") @db.Uuid // empty = every branch
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  gym           Gym                  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  subscriptions MemberSubscription[]

  @@index([gymId, isActive])
  @@map("membership_plan")
}

enum MemberSubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

/// One sold period of a plan. "Expired" is not stored: an ACTIVE row whose ends_at has passed is expired.
/// Plan terms (entry limit, branches) are copied at sale time so later plan edits do not change sold periods.
model MemberSubscription {
  id                 String                   @id @default(uuid(7)) @db.Uuid
  gymId              String                   @map("gym_id") @db.Uuid
  memberId           String                   @map("member_id") @db.Uuid
  planId             String                   @map("plan_id") @db.Uuid
  branchId           String?                  @map("branch_id") @db.Uuid // branch where it was sold
  status             MemberSubscriptionStatus @default(ACTIVE)
  startsAt           DateTime                 @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime                 @map("ends_at") @db.Timestamptz(3)
  entryLimit         Int?                     @map("entry_limit")
  entriesUsed        Int                      @default(0) @map("entries_used")
  allowedBranchIds   String[]                 @default([]) @map("allowed_branch_ids") @db.Uuid
  priceAmountRial    BigInt                   @map("price_amount_rial")
  discountAmountRial BigInt                   @default(0) @map("discount_amount_rial")
  suspendedAt        DateTime?                @map("suspended_at") @db.Timestamptz(3)
  cancelledAt        DateTime?                @map("cancelled_at") @db.Timestamptz(3)
  renewedFromId      String?                  @map("renewed_from_id") @db.Uuid
  note               String?
  createdByUserId    String?                  @map("created_by_user_id") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  payments   Payment[]
  gym        Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member     Member         @relation(fields: [memberId], references: [id])
  plan       MembershipPlan @relation(fields: [planId], references: [id])
  branch     Branch?        @relation(fields: [branchId], references: [id])
  attendance Attendance[]

  @@index([gymId, status, endsAt])
  @@index([memberId, startsAt(sort: Desc)])
  @@map("member_subscription")
}

// ───────────────────────────── Attendance (Phase 2) ─────────────────────────────

enum CheckinMethod {
  MANUAL
  QR
}

model Attendance {
  id               String        @id @default(uuid(7)) @db.Uuid
  gymId            String        @map("gym_id") @db.Uuid
  branchId         String        @map("branch_id") @db.Uuid
  memberId         String        @map("member_id") @db.Uuid
  subscriptionId   String        @map("subscription_id") @db.Uuid
  checkedInAt      DateTime      @default(now()) @map("checked_in_at") @db.Timestamptz(3)
  checkedOutAt     DateTime?     @map("checked_out_at") @db.Timestamptz(3)
  method           CheckinMethod @default(MANUAL)
  recordedByUserId String?       @map("recorded_by_user_id") @db.Uuid
  idempotencyKey   String?       @map("idempotency_key")

  gym          Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  branch       Branch             @relation(fields: [branchId], references: [id])
  member       Member             @relation(fields: [memberId], references: [id])
  subscription MemberSubscription @relation(fields: [subscriptionId], references: [id])

  @@unique([gymId, idempotencyKey])
  @@index([gymId, branchId, checkedInAt(sort: Desc)])
  @@index([memberId, checkedInAt(sort: Desc)])
  @@map("attendance")
}

model MemberNote {
  id           String   @id @default(uuid(7)) @db.Uuid
  gymId        String   @map("gym_id") @db.Uuid
  memberId     String   @map("member_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, createdAt(sort: Desc)])
  @@map("member_note")
}

// ───────────────────────────── Coaching (Phase 2) ─────────────────────────────

/// Gym-specific details of a user who holds the COACH role in that gym. Created on first edit.
model CoachProfile {
  id                String   @id @default(uuid(7)) @db.Uuid
  gymId             String   @map("gym_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  bio               String?
  specializations   String[] @default([])
  commissionRateBp  Int?     @map("commission_rate_bp") // basis points, used by finance (Phase 3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId])
  @@map("coach_profile")
}

/// Coach ↔ member assignment history. The current coach is the row with ended_at NULL (at most one).
model CoachAthlete {
  id          String    @id @default(uuid(7)) @db.Uuid
  gymId       String    @map("gym_id") @db.Uuid
  coachUserId String    @map("coach_user_id") @db.Uuid
  memberId    String    @map("member_id") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(3)
  assignedBy  String?   @map("assigned_by") @db.Uuid

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id])

  @@index([gymId, coachUserId, endedAt])
  @@index([memberId])
  @@map("coach_athlete")
}

// ───────────────────────────── Finance (Phase 3) ─────────────────────────────

enum PaymentMethod {
  CASH
  CARD_POS
  TRANSFER
  ONLINE
}

/// Money received. Never deleted or edited except refunded_amount_rial (raised by refunds under a row lock).
model Payment {
  id                 String        @id @default(uuid(7)) @db.Uuid
  gymId              String        @map("gym_id") @db.Uuid
  branchId           String?       @map("branch_id") @db.Uuid
  memberId           String?       @map("member_id") @db.Uuid
  subscriptionId     String?       @map("subscription_id") @db.Uuid
  amountRial         BigInt        @map("amount_rial")
  refundedAmountRial BigInt        @default(0) @map("refunded_amount_rial")
  method             PaymentMethod
  reference          String? // POS tracking number, transfer reference, gateway ref
  note               String?
  receivedByUserId   String?       @map("received_by_user_id") @db.Uuid
  idempotencyKey     String?       @map("idempotency_key")
  paidAt             DateTime      @default(now()) @map("paid_at") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  gym          Gym                 @relation(fields: [gymId], references: [id], onDelete: Cascade)
  subscription MemberSubscription? @relation(fields: [subscriptionId], references: [id])

  @@unique([gymId, idempotencyKey])
  @@index([gymId, paidAt])
  @@index([subscriptionId])
  @@index([memberId])
  @@map("payment")
}

enum LedgerType {
  INCOME
  REFUND
  EXPENSE
  /// Positive row that cancels a voided expense (the ledger is append-only).
  EXPENSE_VOID
}

/// Append-only money ledger (runtime role has no UPDATE/DELETE). amount_rial is signed: in > 0, out < 0.
model LedgerEntry {
  id              String        @id @default(uuid(7)) @db.Uuid
  gymId           String        @map("gym_id") @db.Uuid
  branchId        String?       @map("branch_id") @db.Uuid
  type            LedgerType
  amountRial      BigInt        @map("amount_rial")
  method          PaymentMethod
  memberId        String?       @map("member_id") @db.Uuid
  paymentId       String?       @map("payment_id") @db.Uuid
  expenseId       String?       @map("expense_id") @db.Uuid
  saleId          String?       @map("sale_id") @db.Uuid
  description     String?
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  occurredAt      DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, occurredAt])
  @@index([gymId, branchId, occurredAt])
  @@map("ledger_entry")
}

enum OnlinePaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

/// A pay-by-link request for a member's debt, settled through the bank gateway (Saman SEP).
/// res_num is the unguessable public id in the link and the gateway's ResNum.
model OnlinePaymentRequest {
  id             String              @id @default(uuid(7)) @db.Uuid
  gymId          String              @map("gym_id") @db.Uuid
  branchId       String?             @map("branch_id") @db.Uuid
  memberId       String              @map("member_id") @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  amountRial     BigInt              @map("amount_rial")
  resNum         String              @unique @map("res_num")
  gateway        String              @default("saman")
  token          String?
  status         OnlinePaymentStatus @default(PENDING)
  refNum         String?             @unique @map("ref_num")
  rrn            String?
  cardMask       String?             @map("card_mask")
  failureReason  String?             @map("failure_reason")
  paymentId      String?             @unique @map("payment_id") @db.Uuid
  createdByUserId String?            @map("created_by_user_id") @db.Uuid
  expiresAt      DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt      DateTime?           @map("settled_at") @db.Timestamptz(3)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, createdAt])
  @@index([subscriptionId])
  @@map("online_payment_request")
}

model ExpenseCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  gymId     String   @map("gym_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  gym      Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([gymId, name])
  @@map("expense_category")
}

/// Money paid out by the gym. Never edited or deleted: a mistake is voided (with a reason) and re-entered.
model Expense {
  id              String        @id @default(uuid(7)) @db.Uuid
  gymId           String        @map("gym_id") @db.Uuid
  branchId        String?       @map("branch_id") @db.Uuid
  categoryId      String        @map("category_id") @db.Uuid
  amountRial      BigInt        @map("amount_rial")
  method          PaymentMethod
  description     String?
  spentAt         DateTime      @map("spent_at") @db.Timestamptz(3)
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt        DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedByUserId  String?       @map("voided_by_user_id") @db.Uuid
  voidReason      String?       @map("void_reason")

  gym      Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([gymId, spentAt])
  @@map("expense")
}

/// Money paid to a coach against a month's commission. Always backed by an expense (category salaries).
model CoachPayout {
  id              String   @id @default(uuid(7)) @db.Uuid
  gymId           String   @map("gym_id") @db.Uuid
  coachUserId     String   @map("coach_user_id") @db.Uuid
  /// Jalali period the payout settles.
  periodYear      Int      @map("period_year")
  periodMonth     Int      @map("period_month")
  amountRial      BigInt   @map("amount_rial")
  expenseId       String   @unique @map("expense_id") @db.Uuid
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, periodYear, periodMonth])
  @@map("coach_payout")
}

enum ProductKind {
  STORE
  BUFFET
}

enum StockReason {
  PURCHASE
  ADJUST
  SALE
  SALE_VOID
}

model Product {
  id         String      @id @default(uuid(7)) @db.Uuid
  gymId      String      @map("gym_id") @db.Uuid
  kind       ProductKind
  name       String
  sku        String?
  priceRial  BigInt      @map("price_rial")
  /// false for items made to order (tea, shakes): no stock count.
  trackStock Boolean     @default(true) @map("track_stock")
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  gym    Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  stock  ProductStock[]

  @@unique([gymId, name])
  @@map("product")
}

/// Current on-hand quantity per branch. Kept in step with stock_movement inside the same transaction.
model ProductStock {
  gymId     String   @map("gym_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, branchId])
  @@index([gymId, branchId])
  @@map("product_stock")
}

/// Every stock change, append-only.
model StockMovement {
  id              String      @id @default(uuid(7)) @db.Uuid
  gymId           String      @map("gym_id") @db.Uuid
  productId       String      @map("product_id") @db.Uuid
  branchId        String      @map("branch_id") @db.Uuid
  delta           Int
  reason          StockReason
  saleId          String?     @map("sale_id") @db.Uuid
  note            String?
  createdByUserId String?     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([gymId, productId, createdAt])
  @@map("stock_movement")
}

/// A counter sale (shop or buffet). Never edited; voided with a reason, which returns stock and money.
model Sale {
  id              String        @id @default(uuid(7)) @db.Uuid
  gymId           String        @map("gym_id") @db.Uuid
  branchId        String        @map("branch_id") @db.Uuid
  memberId        String?       @map("member_id") @db.Uuid
  totalRial       BigInt        @map("total_rial")
  method          PaymentMethod
  idempotencyKey  String?       @map("idempotency_key")
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt        DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedByUserId  String?       @map("voided_by_user_id") @db.Uuid
  voidReason      String?       @map("void_reason")

  gym   Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  items SaleItem[]

  @@unique([gymId, idempotencyKey])
  @@index([gymId, createdAt])
  @@map("sale")
}

model SaleItem {
  id            String @id @default(uuid(7)) @db.Uuid
  gymId         String @map("gym_id") @db.Uuid
  saleId        String @map("sale_id") @db.Uuid
  productId     String @map("product_id") @db.Uuid
  /// Name and price at the time of sale.
  name          String
  quantity      Int
  unitPriceRial BigInt @map("unit_price_rial")
  lineTotalRial BigInt @map("line_total_rial")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_item")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// One automatic message to a member. (kind, dedupe_key) is unique so a job can never send twice.
model NotificationLog {
  id             String             @id @default(uuid(7)) @db.Uuid
  gymId          String             @map("gym_id") @db.Uuid
  memberId       String?            @map("member_id") @db.Uuid
  kind           String
  dedupeKey      String             @map("dedupe_key")
  channel        String             @default("sms")
  status         NotificationStatus @default(PENDING)
  providerRef    String?            @map("provider_ref")
  error          String?
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt         DateTime?          @map("sent_at") @db.Timestamptz(3)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([kind, dedupeKey])
  @@index([gymId, createdAt])
  @@map("notification_log")
}

/// A coach's training plan for one member. At most one active per member; older ones stay as history.
/// days: [{ title, exercises: [{ name, sets, reps, restSeconds?, note? }] }]
model WorkoutProgram {
  id              String    @id @default(uuid(7)) @db.Uuid
  gymId           String    @map("gym_id") @db.Uuid
  memberId        String    @map("member_id") @db.Uuid
  coachUserId     String?   @map("coach_user_id") @db.Uuid
  title           String
  goal            String?
  notes           String?
  days            Json
  isActive        Boolean   @default(true) @map("is_active")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, memberId, createdAt])
  @@index([gymId, coachUserId])
  @@map("workout_program")
}

/// Platform-wide settings edited by the super admin (site name, support contacts, landing content).
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("platform_setting")
}
