# Copy to /etc/smartgym/smartgym.env (chmod 600, owned by root). Never commit the real file.
# Generate each secret with: openssl rand -hex 32
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
OTP_PEPPER=
JWT_SECRET=

# Public https URL, no trailing slash (also the Saman callback base)
APP_URL=https://app.example.ir

SMS_PROVIDER=melipayamak
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_OTP_BODY_ID=
MELIPAYAMAK_EXPIRY_BODY_ID=

PAYMENT_GATEWAY=saman

# AI assistant (any OpenAI-compatible provider, e.g. AvalAI / GapGPT / Metis). Leave AI_PROVIDER=none to disable.
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT_PER_GYM=50
