# GEMINI_API_KEY: Required for the AI endpoints (server-side only).
GEMINI_API_KEY=""

# APP_URL: The URL where this app is hosted.
APP_URL=""

# MySQL / phpMyAdmin Configuration for cPanel deployment
DB_HOST=""
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASSWORD=""

# Server Environment Configurations
PORT="3000"
NODE_ENV="production"

# Random string, at least 32 characters (e.g. `openssl rand -hex 32`).
# Without it, a random secret is generated at startup and logins reset on every restart.
JWT_SECRET=""

# Set to "true" only while running the first-time installer, then remove it and restart.
INSTALLER_ENABLED=""

# Optional fallback super admin login when no admin is saved in the database.
# Prefer ADMIN_PASSWORD_HASH (bcrypt) over a plain ADMIN_PASSWORD.
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""

# Comma-separated origins allowed to call the API from another domain (leave empty for same-origin only).
CORS_ORIGIN=""
