# Runtime connection: NON-owner role so Postgres row-level security applies.
DATABASE_URL="postgresql://smartgym_app:CHANGE_ME@localhost:5433/smartgym"
# Owner role, used only by `prisma migrate deploy` and the seed.
MIGRATION_DATABASE_URL="postgresql://smartgym_owner:CHANGE_ME@localhost:5433/smartgym"

# Random strings, 32+ characters each (openssl rand -hex 32)
OTP_PEPPER=""
JWT_SECRET=""

# console (development only) | melipayamak | kavenegar
SMS_PROVIDER="console"
# Melipayamak: API key from console.melipayamak.com, bodyId of the approved OTP template
# (template text must contain {0} for the code)
MELIPAYAMAK_API_KEY=""
MELIPAYAMAK_OTP_BODY_ID=""
# Optional: membership expiry reminder template, text with {0} first name, {1} gym name, {2} days left
MELIPAYAMAK_EXPIRY_BODY_ID=""
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE=""
KAVENEGAR_EXPIRY_TEMPLATE=""

# Public URL, used to check the Origin header on cookie-authenticated requests
APP_URL="http://localhost:3001"

# Online payments: saman (production) | sandbox (development, in-app fake bank page).
# The Saman terminal number is set per gym in the manager panel (Settings > Online payment).
# The VPS public IP must be registered with Saman, and APP_URL must be the public https URL.
PAYMENT_GATEWAY="sandbox"

# AI assistant (any OpenAI-compatible provider, e.g. AvalAI / GapGPT / Metis). Leave AI_PROVIDER=none to disable.
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT_PER_GYM=50
